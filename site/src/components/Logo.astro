---
export interface Props {
  class?: string;
}
const { class: cls = "h-8 w-8" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  class={cls}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="kg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f97316" />
      <stop offset="1" stop-color="#0f766e" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="#12201f" />
  <rect
    x="0.5"
    y="0.5"
    width="63"
    height="63"
    rx="13.5"
    fill="none"
    stroke="#2dd4bf"
    stroke-opacity="0.35"
  />
  <path d="M17 23 C25 14 39 14 47 23" fill="none" stroke="url(#kg)" stroke-width="5" stroke-linecap="round" />
  <path d="M17 41 C25 50 39 50 47 41" fill="none" stroke="#f4f1ea" stroke-opacity="0.9" stroke-width="3" stroke-linecap="round" />
  <circle cx="17" cy="23" r="5" fill="#fdba74" />
  <circle cx="47" cy="23" r="5" fill="#2dd4bf" />
  <circle cx="32" cy="41" r="5" fill="#f4f1ea" />
</svg>
