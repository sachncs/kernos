---
import "../styles/global.css";
import { withBase, BASE } from "../lib/base";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = "Kernos — Refresh-aware hybrid kernel learning for scalable regression",
  description = "A Python library that learns adaptive low-rank kernels for regression. Refresh the basis only when it drifts. Built around a familiar scikit-learn-style interface.",
  image = "/og.svg",
  canonical,
} = Astro.props;

const siteUrl = "https://sachncs.github.io/kernos";
const fullImage = `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0d" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:site_name" content="Kernos" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/logo-mark.svg")} />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Kernos",
      "applicationCategory": "DeveloperApplication",
      "description": description,
      "url": siteUrl,
      "downloadUrl": "https://pypi.org/project/kernos/",
      "license": "https://opensource.org/licenses/MIT",
      "programmingLanguage": "Python",
      "author": {
        "@type": "Person",
        "name": "Sachin"
      }
    })} />
  </head>
  <body class="bg-ink-950 text-ink-50 antialiased selection:bg-accent-500/30">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  .skip-link {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    border-radius: 0.75rem;
    background: #f0a15f;
    color: #0b1115;
    padding: 0.65rem 0.9rem;
    font-size: 0.875rem;
    font-weight: 700;
    transition: top 160ms ease;
  }

  .skip-link:focus-visible {
    top: 1rem;
  }
</style>
